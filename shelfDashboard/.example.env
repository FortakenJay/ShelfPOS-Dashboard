VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public dashboard URL for Supabase auth email redirects (required in production)
# Vercel: https://shelfpos.net
# Also set Supabase Auth → URL Configuration → Site URL to the same value.
VITE_DASHBOARD_URL=https://shelfpos.net
# Server-only — Supabase → Settings → API Keys → Secret key (sb_secret_…). Never VITE_ prefix.
SUPABASE_SECRET_KEY=
# Server-only — Discord webhook for unpaid billing reminders (@here ping). Never VITE_ prefix.
DISCORD_BILLING_WEBHOOK_URL=
# Server-only — shared secret for POST /api/cron/billing-reminders.
# Must match GitHub Actions secret BILLING_CRON_SECRET (see .github/workflows/billing-reminders.yml).
BILLING_CRON_SECRET=
# Optional fallback for /create-account?key=… when not using Supabase invite links
VITE_SIGNUP_INVITE_KEY=
